  {
    "chapter": "basics-robot",
    "kind": "curated-diagram",
    "key": "robot-loop",
    "figure": "basics-robot-diagram-robot-loop",
    "after": "basics-robot-p1",
    "paragraphExcerpt": "机器人链条广，但展示视频、样机和稳定量产是不同阶段。真正的市场取决于可靠性、成本和场景价值。",
    "src": "/handbook/diagrams/3dd686390875a1b3bce9.svg"
  },
  {
    "chapter": "basics-robot",
    "kind": "curated-diagram",
